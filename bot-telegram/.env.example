# Code secret donné par @BotFather (obligatoire)
TELEGRAM_BOT_TOKEN=colle-ton-token-ici

# Ton numéro d'utilisateur Telegram (optionnel) : donne accès à /stats
# Pour le connaître, envoie /monid au bot une fois lancé.
ADMIN_USER_ID=

# Limites par utilisateur
MAX_PHOTOS_PER_HOUR=20
MAX_PHOTOS_PER_DAY=60

# Limites par envoi
MAX_PHOTOS_PER_ALBUM=10
MAX_FILE_SIZE_MB=15

# Nombre de photos traitées en même temps (garde 2 sur un hébergement gratuit)
MAX_CONCURRENT_JOBS=2

# Temps maximum de traitement d'une photo, en secondes
PROCESSING_TIMEOUT_SECONDS=60

# Anti-spam : plus de SPAM_MAX_MESSAGES messages en SPAM_WINDOW_SECONDS secondes
# => utilisateur ignoré pendant SPAM_MUTE_SECONDS secondes
SPAM_MAX_MESSAGES=5
SPAM_WINDOW_SECONDS=10
SPAM_MUTE_SECONDS=60

# Messages maximum par minute dans un même groupe (limite Telegram ~20)
GROUP_MAX_MESSAGES_PER_MINUTE=20
# Pause entre deux photos d'un même album, en secondes
ALBUM_SEND_PAUSE_SECONDS=1

# Fichier des statistiques anonymes
STATS_DB_PATH=stats.db
